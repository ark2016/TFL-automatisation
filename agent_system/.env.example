# TFL Agent System — environment variables
# Copy this file to .env and fill in your values.

# Anthropic API key (required for LLM agents: classifier, re_builder, pumping, etc.)
ANTHROPIC_API_KEY=sk-ant-...

# Model overrides (optional, defaults shown)
# TFL_MODEL_FAST=claude-sonnet-4-6
# TFL_MODEL_DEEP=claude-opus-4-7

# Docker image name for Lean 4 type checker (optional)
# TFL_DOCKER_IMAGE=tfl-lean4

# Lean type check timeout in seconds (optional)
# TFL_LEAN_TIMEOUT=120
