FROM debian:stable-slim
RUN apt-get update && apt-get install -y curl git && apt-get clean
RUN useradd -m lean
USER lean
WORKDIR /home/lean
ENV PATH="/home/lean/.elan/bin:$PATH"
RUN curl https://elan.lean-lang.org/elan-init.sh -sSf | sh -s -- -y --default-toolchain none
RUN elan default leanprover/lean4:v4.18.0
RUN lake --version && lean --version

# ---------------------------------------------------------------------------
# Mathlib (Computability: DFA, RegularExpressions) — pinned lake project.
#
# The formalizer prompt (agent_system/prompts/formalizer.md) and live-run
# Lean examples (ll_system/examples/live_outputs/*.lean) import
# Mathlib.Computability.DFA / Mathlib.Computability.RegularExpressions.
# Pre-building this tiny project here warms the Mathlib .olean cache inside
# the image so agent_system/lib/type_check.py's `lake env lean <file>` calls
# don't need to compile Mathlib on every check.
#
# lake-manifest.json is committed (see agent_system/docker/tfl_lean/), so the
# mathlib revision is reproducible; `lake exe cache get` fetches Mathlib's
# precompiled .olean cache instead of building it from source (which would
# take hours), then `lake build` finishes the (trivial) TflLean target.
# ---------------------------------------------------------------------------
WORKDIR /home/lean/tfl_lean
COPY --chown=lean:lean tfl_lean/lean-toolchain ./lean-toolchain
COPY --chown=lean:lean tfl_lean/lakefile.toml ./lakefile.toml
COPY --chown=lean:lean tfl_lean/lake-manifest.json ./lake-manifest.json
COPY --chown=lean:lean tfl_lean/TflLean.lean ./TflLean.lean
RUN lake exe cache get
RUN lake build
WORKDIR /home/lean
