# Pinned by digest (code review 2026-09-28, major: reproducibility --
# `debian:stable-slim` is a floating tag that can point at a different
# image tomorrow). Refresh with `docker pull debian:stable-slim && docker
# inspect --format='{{index .RepoDigests 0}}' debian:stable-slim`.
FROM debian:stable-slim@sha256:5bc3287b25407c965a30f38e32603dc253a3869e1b12a21ac09bfc27fd8b13ce
RUN apt-get update && apt-get install -y curl git && apt-get clean
RUN useradd -m lean
USER lean
WORKDIR /home/lean
ENV PATH="/home/lean/.elan/bin:$PATH"
# Pinned to elan v4.2.4's exact commit (rather than the floating
# https://elan.lean-lang.org/elan-init.sh, which always serves whatever the
# latest release happens to be) and verified against a known-good sha256
# before it is ever run, per the same code review finding. Refresh both the
# commit and the checksum together when bumping elan: find the new tag's
# commit with `git ls-remote --tags https://github.com/leanprover/elan.git`,
# then `curl -fsSL https://raw.githubusercontent.com/leanprover/elan/<commit>/elan-init.sh
# | sha256sum`.
RUN curl -fsSL -o /tmp/elan-init.sh \
      https://raw.githubusercontent.com/leanprover/elan/227caca133724d5516bee25c2aeb3e609478f2d8/elan-init.sh && \
    echo "a620ff1641616222c8d37c54845492004bb84d6877cdbc944dd65c1aa685bf53  /tmp/elan-init.sh" | sha256sum -c - && \
    sh /tmp/elan-init.sh -y --default-toolchain none && \
    rm /tmp/elan-init.sh
RUN elan default leanprover/lean4:v4.33.0
RUN lake --version && lean --version

# ---------------------------------------------------------------------------
# Mathlib (Computability: DFA, RegularExpressions, MyhillNerode,
# ContextFreeGrammar) + langlib (Regular/ContextFree/DeterministicContextFree
# classes, Ogden's & pumping lemmas, closure properties, worked examples) —
# pinned lake project. See agent_system/docker/tfl_lean/TflLean/Basic.lean
# and TflLean/Langlib.lean for exactly which imports this warms, and
# ../tz_tfl_agent_system.md / the formalizer prompt for why.
#
# Both the Mathlib and langlib revisions are pinned by `rev` in lakefile.toml
# (langlib by commit, since it has no version tags): langlib's own lakefile
# requires the same Mathlib tag we do (verified against langlib's own
# lake-manifest.json at the pinned commit: it resolves Mathlib to the same
# `v4.33.0`), and Mathlib's tagged lakefile.lean/manifest pin its own
# transitive deps (aesop, batteries, Qq, ...), so nothing here floats.
#
# lake-manifest.json IS committed here (tfl_lean/lake-manifest.json),
# regenerated by `lake update` on a normal-bandwidth connection and copied
# out of a built container — see the README's Lean section for the pinned
# revisions it resolves to. Committing it means every build fetches the
# exact same pinned commits directly (no network-based version resolution),
# which is both faster and fully reproducible. If lakefile.toml's pins ever
# change, regenerate the manifest the same way (`lake update` in a container,
# `docker cp` the file out, commit it) rather than editing it by hand.
#
# `lake exe cache get` fetches Mathlib's precompiled .olean cache instead of
# building it from source (which would take hours). langlib has no such
# cache — `lake build` only compiles the langlib modules TflLean.Langlib
# actually imports (transitively), not the whole library.
#
# Split into checkpoint layers (cache get; build TflLean.Basic; build
# TflLean.Langlib) so a build that gets interrupted — or fails on a later
# step — resumes from the last completed layer via BuildKit's cache instead
# of re-fetching/re-building everything.
# ---------------------------------------------------------------------------
WORKDIR /home/lean/tfl_lean
COPY --chown=lean:lean tfl_lean/lean-toolchain ./lean-toolchain
COPY --chown=lean:lean tfl_lean/lakefile.toml ./lakefile.toml
COPY --chown=lean:lean tfl_lean/lake-manifest.json ./lake-manifest.json
RUN lake exe cache get

COPY --chown=lean:lean tfl_lean/TflLean/Basic.lean ./TflLean/Basic.lean
RUN lake build TflLean.Basic

COPY --chown=lean:lean tfl_lean/TflLean/Langlib.lean ./TflLean/Langlib.lean
RUN lake build TflLean.Langlib

# TflLean.Lemmas: reusable lemmas for proof bodies (counting, Myhill–Nerode,
# pumping, plus the transfer section: langlib's DCFL ⊆ CFL inclusion, CF closure
# under inverse homomorphism / ∩ REG and the {aⁿbⁿcᵐ} DPDA moved onto any
# alphabet). Imports the langlib modules pulled in above, so it is built last;
# editing it only rebuilds this small layer. TflLean.lean
# re-exports it, so a harness file's `import TflLean` sees `TflLean.*`.
COPY --chown=lean:lean tfl_lean/TflLean/Lemmas.lean ./TflLean/Lemmas.lean
COPY --chown=lean:lean tfl_lean/TflLean.lean ./TflLean.lean
RUN lake build
WORKDIR /home/lean
